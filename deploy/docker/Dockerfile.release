# syntax=docker/dockerfile:1
#
# Release image: the static musl binaries that the release workflow has already
# built and tested, copied onto distroless/static. Nothing is compiled here, so
# the multi-arch build needs no emulation and the image runs exactly the binary
# attached to the GitHub Release.
#
# Build context layout (prepared by .github/workflows/release.yml):
#   linux-amd64/shadoucmdb
#   linux-arm64/shadoucmdb
#
# To build from source instead, use the root Dockerfile.

FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
COPY --chmod=0755 linux-${TARGETARCH}/shadoucmdb /usr/local/bin/shadoucmdb
ENV API_HOST=0.0.0.0 \
    API_PORT=3000
EXPOSE 3000
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/shadoucmdb"]
# Migrations are a separate, explicit step: `docker run ... shadoucmdb migrate`.
CMD ["serve"]
