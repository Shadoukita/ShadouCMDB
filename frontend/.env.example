# ShadouCMDB web UI configuration. Copy to .env (ignored by git) and fill in.
# The UI only ever talks to the backend API. It never receives database credentials.

# Base URL of the backend API, without the /api/v1 suffix, e.g. https://cmdb-api.example.com
# Baked in at build time. Leave empty to call the API on the same origin as the UI
# (behind a reverse proxy, or through API_PROXY_TARGET below in development).
# At runtime, public/config.js (window.__SHADOUCMDB_CONFIG__.apiBaseUrl) overrides it without a rebuild.
VITE_API_BASE_URL=

# Development / preview only: proxy /api on the Vite server to this backend, e.g. http://api-host:3000
# (keeps the browser same-origin, so the API needs no CORS_ORIGINS entry).
API_PROXY_TARGET=

# Port for `npm run dev` (default 5173) and `npm run preview` (default 4173).
WEB_PORT=
