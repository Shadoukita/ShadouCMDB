# ShadouCMDB configuration. Copy to .env and fill in. Every variable the backend
# reads is listed here; the shadoucmdb binary and the Node API read the same set with the
# same meaning (shadoucmdb loads ./.env, or the file given with --env-file). PostgreSQL is an external service: there is no default
# host, so nothing works until you point it at your database.

# --- PostgreSQL connection: set EITHER DATABASE_URL OR the PG* variables below ---

# Full connection string; takes precedence over PG* when set. Any sslmode in it is ignored (use DATABASE_SSL).
DATABASE_URL=
# Database server hostname or IP (required if DATABASE_URL is empty).
PGHOST=db.example.internal
# Database server port (optional, defaults to 5432).
PGPORT=5432
# Database name (required if DATABASE_URL is empty).
PGDATABASE=shadoucmdb
# Database role the backend connects as; must own the database or have CREATE on it to run migrations.
PGUSER=shadoucmdb_app
# Password for PGUSER. Never commit a real value.
PGPASSWORD=change-me

# --- TLS and pool ---

# TLS mode: disable | require (encrypted, certificate not verified) | verify-full (encrypted + verified). Default: require.
DATABASE_SSL=require
# Path to a PEM CA bundle used with verify-full for private/managed CAs (optional).
DATABASE_SSL_CA_FILE=
# Maximum connections in the backend pool (optional, default 10).
DATABASE_POOL_MAX=10
# Per-statement timeout in milliseconds, 0 disables (optional, default 30000).
DATABASE_STATEMENT_TIMEOUT_MS=30000
# How long to wait for a new database connection before failing the request, in ms (optional, default 5000).
DATABASE_CONNECT_TIMEOUT_MS=5000

# --- API server ---

# Interface the API binds to (optional, default 0.0.0.0).
API_HOST=0.0.0.0
# Port the API listens on (optional, default 3000).
API_PORT=3000
# Comma-separated browser origins allowed to call the API cross-origin, e.g. https://cmdb.example.com
# (optional; empty = no CORS headers, i.e. serve the UI from the same origin or through a proxy).
CORS_ORIGINS=
# Log level: fatal | error | warn | info | debug | trace | silent (optional, default info).
LOG_LEVEL=info
# Runtime mode: production | development | test (optional, default production). In the Node API,
# development/test also check every API response against its OpenAPI schema and fail loudly (500) on drift.
NODE_ENV=production
