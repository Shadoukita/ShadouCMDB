# ShadouCMDB configuration. Copy to .env and fill in. Every variable the
# shadoucmdb binary reads is listed here (it loads ./.env, or the file given with
# --env-file; variables already set in the environment win). PostgreSQL is an
# external service: there is no default host, so nothing works until you point
# it at your database.

# --- PostgreSQL connection: set EITHER DATABASE_URL OR the PG* variables below ---

# Full connection string; takes precedence over PG* when set. Any sslmode in it is ignored (use DATABASE_SSL).
DATABASE_URL=
# Database server hostname or IP (required if DATABASE_URL is empty).
PGHOST=db.example.internal
# Database server port (optional, defaults to 5432).
PGPORT=5432
# Database name (required if DATABASE_URL is empty).
PGDATABASE=shadoucmdb
# Database role the API connects as (shadoucmdb_app by default; any name works, `migrate` grants to this user).
# With MIGRATION_DATABASE_URL unset it also runs migrations.
PGUSER=shadoucmdb_app
# Password for PGUSER. Never commit a real value.
PGPASSWORD=change-me

# --- Other database roles (sql/bootstrap/00_create_role_and_database.sql creates all three) ---

# Connection string `shadoucmdb migrate`, `restore`, `factory-reset` and `decommission` use instead of
# the above: the schema owner (shadoucmdb_owner by default)
# (optional; unset = migrate as the API role, which only works on a single-role install). Keep it out of
# the environment of the running server.
MIGRATION_DATABASE_URL=
# Connection string for `shadoucmdb prune-audit`: the maintenance role (shadoucmdb_maintenance by default), which
# may only run the audit_log purge (required by that command; never set it to the API role). Also set it when you run
# `migrate`, which grants the purge to this user.
MAINTENANCE_DATABASE_URL=

# --- TLS and pool ---

# TLS mode (optional, default verify-full): verify-full (encrypted, certificate chain and host name verified) |
# require (encrypted, certificate NOT verified; logs a warning for a non-loopback host) | disable (plain TCP).
DATABASE_SSL=verify-full
# Path to a PEM CA bundle for verify-full when the server certificate is from a private or managed-service CA
# (optional; unset = the Mozilla roots built into the binary).
DATABASE_SSL_CA_FILE=
# Maximum connections in the backend pool (optional, default 10).
DATABASE_POOL_MAX=10
# Per-statement timeout in milliseconds, 0 disables (optional, default 30000).
DATABASE_STATEMENT_TIMEOUT_MS=30000
# How long to wait for a new database connection before failing the request, in ms (optional, default 5000).
DATABASE_CONNECT_TIMEOUT_MS=5000

# --- API server ---

# Interface the API binds to (optional, default 0.0.0.0).
API_HOST=0.0.0.0
# Port the API listens on (optional, default 3000).
API_PORT=3000
# Comma-separated browser origins allowed to call the API cross-origin, e.g. https://cmdb.example.com
# (optional; empty = no CORS headers, i.e. serve the UI from the same origin or through a proxy).
# Each entry is scheme://host[:port] exactly as the browser sends it (no path, no trailing slash);
# "*" is rejected at startup, because the session cookie makes these credentialed requests.
CORS_ORIGINS=
# Where browsers send Content-Security-Policy violation reports (optional; empty = no reporting, the default).
# An absolute http(s) URL, e.g. https://reports.example.com/csp, or a path on this server, e.g. /csp-reports.
# Reports go to whatever you point this at; the ShadouCMDB project never receives them. No whitespace, ";" or
# "," (percent-encode them) and no user:password@; anything else stops the server at startup.
CSP_REPORT_URI=
# Who can read the OpenAPI contract (/openapi.json) and Swagger UI (/docs): off | authenticated (any signed-in
# user) | public (optional, default off). The contract is also in the repository as backend/openapi.json.
API_DOCS=off
# Seconds a client may take to send the request line and headers before the connection is closed (optional,
# default 10; 1 to 3600). Protects against slowloris-style connection exhaustion. Also the time a public route
# (setup, sign-in) may take to receive its body before it is answered 408 REQUEST_TIMEOUT.
HTTP_HEADER_READ_TIMEOUT_SECS=10
# Seconds a whole request (upload included) may take before it is answered 408 REQUEST_TIMEOUT and its
# transaction is rolled back (optional, default 120; 1 to 86400).
HTTP_REQUEST_TIMEOUT_SECS=120
# API requests the server handles at once; further requests are answered 503 SERVER_BUSY with Retry-After until
# one finishes (optional, default 512; 1 to 1000000). Setup and sign-in draw from a separate pool of one eighth of
# this (at least 16), so anonymous callers cannot use up the capacity of signed-in users; /healthz, /readyz and
# /api/v1/version are exempt. Bounds memory under a request flood: request bodies are read only after
# authentication, up to 64 KiB on the sign-in routes, 1 MiB elsewhere and 16 MiB on configuration import.
HTTP_MAX_CONCURRENT_REQUESTS=512
# Log level: fatal | error | warn | info | debug | trace | silent (optional, default info).
LOG_LEVEL=info

# --- Sign-in sessions ---

# A session ends after this many minutes without a request (optional, default 720 = 12 h; 5 to 525600).
SESSION_IDLE_TIMEOUT_MINUTES=720
# A session ends this many hours after sign-in, however active (optional, default 168 = 7 days; 1 to 8760).
SESSION_MAX_AGE_HOURS=168
# Secure attribute on the session cookies: auto (when the reverse proxy reports HTTPS via
# X-Forwarded-Proto or Forwarded) | always | never (optional, default auto). Use always behind a TLS proxy
# that does not send X-Forwarded-Proto.
COOKIE_SECURE=auto

# --- Enterprise sign-in (OIDC, LDAP/AD) ---

# The address users open the web UI at, e.g. https://cmdb.example.com (optional; a path is allowed, no query).
# Required for OIDC sign-in: the redirect URI registered at the provider is PUBLIC_URL/api/v1/auth/oidc/callback,
# built from this value and never from the request's Host header. Unset, OIDC buttons are hidden. Providers and
# directories themselves are set up in the web UI (Administration), not here.
PUBLIC_URL=
# Outbound calls to OIDC providers honour the standard proxy variables (optional): HTTPS_PROXY=http://proxy:3128
# and NO_PROXY=.corp.example. LDAP connections are direct TCP and do not use a proxy.
# The only hosts the server may contact for OIDC (optional), comma-separated, each a host name or IP address with an
# optional :port, e.g. login.example.com,idp.corp.example:8443. Names match exactly, never as a suffix. The discovery
# URL and the token and key set URLs it names are all checked. Unset (the default): any host.
OIDC_ALLOWED_HOSTS=

# --- Audit trail ---

# Record the client IP address of sign-ins and sessions: true | false (optional, default true).
# Set false where a works council or data-protection policy rules out storing it. Changes are still
# attributed to the signed-in user; that is what the audit log is for.
AUDIT_CAPTURE_CLIENT_IP=true
# Record the browser's User-Agent of sign-ins and sessions: true | false (optional, default true).
AUDIT_CAPTURE_USER_AGENT=true
# Copy every new audit_log row to a SIEM or log collector (optional, default off):
#   off | stdout | file:/path/to/audit.jsonl | udp://host:port | tcp://host:port
# udp/tcp speak syslog (RFC 5426 / RFC 6587 octet counting). No TLS: use a local relay (rsyslog, Vector,
# Fluent Bit) for encrypted transport to a remote SIEM.
AUDIT_EXPORT=off
# Export format: json (one JSON object per line) | rfc5424 (syslog, the JSON in MSG). Default: rfc5424 for
# udp/tcp, json for stdout/file.
AUDIT_EXPORT_FORMAT=
# Syslog facility number for rfc5424, 0 to 23 (optional, default 13 = log audit).
AUDIT_SYSLOG_FACILITY=13
# How often the exporter looks for new audit rows, in ms (optional, default 2000; 100 to 3600000).
AUDIT_EXPORT_POLL_MS=2000
